<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Baby Shower Samantha</title>
<link href="https://fonts.googleapis.com/css2?family=Bellefair&family=Jost:wght@300;400;500&family=Monsieur+La+Doulaise&display=swap" rel="stylesheet">
<style>
:root{--cw:min(92vw,54svh,460px);--ew:calc(var(--cw)*.9);--rose:#c8567f;--rose-d:#a93f69;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;margin:0}
body{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:16px 0;font-family:'Jost',system-ui,sans-serif;color:var(--rose);overflow-x:hidden;
background:radial-gradient(50% 35% at 10% 8%,#f7a8c4aa,transparent),radial-gradient(45% 35% at 95% 30%,#fbc8b6aa,transparent),radial-gradient(60% 40% at 10% 95%,#f5a3c2aa,transparent),linear-gradient(160deg,#fde6ea,#f9cfdc 55%,#fcdcd3)}
.defs{position:absolute;width:0;height:0}
.stage{position:relative;width:var(--cw);height:calc(var(--cw)*1.4)}
/* Carta */
.card{position:absolute;inset:0;container-type:inline-size;border-radius:2cqw;text-align:center;display:flex;flex-direction:column;align-items:center;padding-top:33cqw;z-index:2;
background:radial-gradient(60% 38% at 12% 8%,#f8b8cf99,transparent 70%),radial-gradient(45% 35% at 92% 28%,#fbcbb877,transparent),radial-gradient(60% 35% at 8% 88%,#f6a9c777,transparent),radial-gradient(60% 35% at 94% 94%,#f8b0c888,transparent),#fcf3f1;
box-shadow:0 14px 40px rgba(200,80,120,.28);transform:scale(.38);transform-origin:center;visibility:hidden}
.play .card{visibility:visible;animation:letter 5.2s both}
@keyframes letter{0%,36%{transform:translateY(0) scale(.38);z-index:2;animation-timing-function:ease-out}
61.3%{transform:translateY(calc(var(--cw)*-.27)) scale(.38);z-index:2}
61.4%{z-index:10;animation-timing-function:cubic-bezier(.3,.8,.3,1)}
100%{transform:translateY(0) scale(1);z-index:10}}
.card svg,.card img{position:absolute}
.card h1,.card p,.card .row{position:relative}
.script{font-family:'Monsieur La Doulaise','Brush Script MT',cursive;font-size:9.5cqw;line-height:1;color:var(--rose)}
h1{font:400 16.5cqw/.95 'Bellefair',Georgia,serif;color:#d0648f;letter-spacing:-.01em}
.msg{width:64cqw;font-size:3.2cqw;line-height:1.5;font-weight:400;color:#b5527c;margin:3.5cqw 0 4.5cqw}
.tw{font-size:3.2cqw;letter-spacing:.12em;font-weight:400;color:#b5527c}
.row{display:flex;align-items:center;gap:4cqw;margin-top:2.5cqw;font:400 5.4cqw/1 'Bellefair',Georgia,serif;color:#d0648f}
.row i{width:1px;height:7cqw;background:#d0648f}
.time{font-size:6.5cqw;margin-top:1cqw}
.addr{font-size:3.2cqw;letter-spacing:.1em;line-height:1.6;margin-top:2.5cqw;color:#c0668b}
/* Decoración */
.rb{width:13cqw;height:65cqw;top:26cqw}.rb.l{left:-2cqw}.rb.r{right:-2cqw;transform:scaleX(-1)}
